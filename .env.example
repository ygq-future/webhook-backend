# ============================================================
# Webhook 转发中心 — 环境变量示例
# 复制为 .env 并按需修改（生产环境务必覆盖安全相关项）
# ============================================================

# 监听端口
PORT=3000

# 持久化：默认 SQLite（文件）；接入 Postgres 时改为 postgres:// 连接串
DATABASE_URL=sqlite:./data/app.db
# DATABASE_URL=postgres://wh:wh_password@localhost:5432/webhook

# 前端静态资源目录（生产由后端托管）
WEB_ROOT=./web/dist

# —— 安全相关（生产必须修改）——
# 授权码/密钥加密主密钥（AES-256-GCM，经 scrypt 派生）
ENCRYPT_KEY=change-me-encrypt-key
# 会话 Cookie 签名密钥
SESSION_SECRET=change-me-session-secret

# 管理员账号（二选一：明文 或 scrypt 哈希，哈希优先）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=
